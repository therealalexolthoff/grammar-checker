rules_version = '2';

// No browser or phone ever reads or writes Firestore directly: every
// request goes through the API, which checks who is asking
// (docs/ARCHITECTURE.md section 3, decision 1). The API uses a service
// account, which these rules don't apply to. So: deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
